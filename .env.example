# --- BAT BUOC ---
# Telegram: @BotFather -> /newbot. Chat ID: /getUpdates
TG_TOKEN=
TG_CHAT_ID=

# Alpaca (mien phi): https://alpaca.markets -> Paper Trading -> API Keys
ALPACA_KEY=
ALPACA_SECRET=

# SEC yeu cau User-Agent co ten that + email that (phai co ky tu @)
SEC_UA=Your Name your.email@example.com

# --- TUY CHON ---
# Mau URL cho nut "Bieu do". {sym} = ma chung khoan.
# De trong = https://www.tradingview.com/chart/?symbol={sym}
# Doi de thu dang link nao mo duoc app TradingView tren may cua ban, vd:
#   https://www.tradingview.com/symbols/{sym}/
# KHONG dat tradingview://... vao day: Telegram chi nhan http(s):// va tg://
# nen API se tu choi ca tin nhan. Xem README muc 6.
TV_URL=

# Nut "Hoi ChatGPT" mo mot GPT rieng thay vi ChatGPT thuong.
# Lay ID tu URL cua GPT do: chatgpt.com/g/g-abc123-ten-gpt -> g-abc123-ten-gpt
# De trong = mo ChatGPT thuong.
CHATGPT_GPT_ID=

# Day snapshot len web dieu khien (tab Scanner cua lux-lookthrough).
# De trong CA HAI = push.py khong lam gi, bot chay y nguyen. Day la mac dinh.
#
# URL la endpoint Pages Function, KHONG co dau / o cuoi:
#   https://the-professional.pages.dev/api/scanner
# Token dat phia Cloudflare bang:
#   npx wrangler pages secret put SCANNER_TOKEN --project-name the-professional
# roi dan DUNG chuoi do vao day. No khong phai access code cua app: no chi ghi
# duoc cac khoa scanner:* va khong doc duoc portfolio/watchlist.
# Kiem tra: python push.py --ping
SCANNER_PUSH_URL=
SCANNER_TOKEN=

# --- CHUA DUNG TRONG CODE, de trong duoc ---
FINNHUB_KEY=
ANTHROPIC_API_KEY=
GROQ_KEY=
